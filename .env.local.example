# ----------------------------------------------------------------------------
# NovaSmile Landing - variables de entorno
# Copia este archivo a .env.local y completa los valores.
# ----------------------------------------------------------------------------

# Publicas (llegan al navegador). Necesarias para LEER el catalogo via anon key.
NEXT_PUBLIC_SUPABASE_URL=https://khuewkknabdpqaiubjam.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# Tenant que sirve esta landing (subdominio en la tabla tenants).
NEXT_PUBLIC_TENANT_SUBDOMINIO=novasmile

# ----------------------------------------------------------------------------
# PRIVADA - solo servidor. NUNCA usar prefijo NEXT_PUBLIC_ aqui.
# Secreto HMAC con el que se firma la reserva antes de llamar a la
# Edge Function book-appointment. Debe ser byte-identico al cargado en
# el panel de Edge Functions de Supabase (BOOKING_WEBHOOK_SECRET).
# Si falta, el formulario degrada con un aviso claro en vez de romper.
# ----------------------------------------------------------------------------
BOOKING_WEBHOOK_SECRET=
